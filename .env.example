# =============================================
# Pdfsim 配置文件 — 复制为 .env 使用
# 所有配置重启不丢失
# =============================================

# --- 数据库（Supabase PG）---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=postgres
DB_MAX_CONNECTIONS=10

# --- BGE 模型 ---
FEATURE_DIM=768
BGE_MODEL_NAME=BAAI/bge-base-en-v1.5
BGE_VISUAL_WEIGHT=
USE_GPU=false

# --- 氚云对接 ---
H3YUN_ENGINE_CODE=
H3YUN_ENGINE_SECRET=
H3YUN_BASE_URL=https://www.h3yun.com
H3YUN_PRODUCT_SCHEMA_CODE=Spngcvyjd6zifjq0ye59gikz70
H3YUN_ATTACHMENT_FIELD_CODE=F0000052
H3YUN_NAME_FIELD_CODE=F0000223

# --- 服务 ---
MAX_UPLOAD_MB=50
RENDER_DPI=150
